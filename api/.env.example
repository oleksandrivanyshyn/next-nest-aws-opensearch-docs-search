# Copy to .env and fill in. Never commit .env.

# --- server ---
PORT=5000
CORS_ORIGINS=http://localhost:3000

# --- database (Neon) ---
# Use the POOLED connection string — the host contains "-pooler".
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- aws ---
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=docsearch-uploads-000000000000
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/docsearch-events

# Local development only. Leave these OUT in production — the EC2 instance
# role supplies credentials and the AWS SDK finds them automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- opensearch ---
OPENSEARCH_NODE=https://search-docsearch-xxxxxxxx.us-east-1.es.amazonaws.com
OPENSEARCH_AUTH_USERNAME=admin
OPENSEARCH_AUTH_PASSWORD=
